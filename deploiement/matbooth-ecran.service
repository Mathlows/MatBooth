# Écran de la borne (installé dans ~/.config/systemd/user par deploiement/installer.sh).
[Unit]
Description=Matbooth : écran de la borne (Chromium en plein écran)
StartLimitIntervalSec=0

[Service]
EnvironmentFile=-%h/.config/matbooth-ecran.env
ExecStart=@RACINE@/deploiement/lancer-ecran.sh
# Fermé, planté ou bureau pas encore prêt : on relance.
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
